# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/quizcheck?retryWrites=true&w=majority

# Password for all /admin pages
ADMIN_PASSWORD=change-me

# LLM provider: "anthropic", "openai", or "gemini"
LLM_PROVIDER=anthropic
# API key for the chosen provider (server-side only; never exposed to the browser)
LLM_API_KEY=
# Model id. Defaults: anthropic -> claude-opus-5-5, openai -> gpt-4o, gemini -> gemini-flash-latest
LLM_MODEL=claude-opus-5-5

# Optional: public base URL used for quiz links and QR codes (e.g. https://quizcheck.vercel.app).
# If unset, it is derived from the incoming request.
APP_URL=
